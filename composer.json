        "php": ">=8.5"
    },
    "config": {
        "platform": {
            "php": "8.5.0"
        },
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "require-dev": {
        "codeception/codeception": "^5.0",
        "codeception/module-asserts": "^3.0",
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.0",
        "rector/rector": "^2.7",
        "infection/infection": "^0.35.10",
        "infection/codeception-adapter": "^0.4.7"
    },
    "autoload": {
