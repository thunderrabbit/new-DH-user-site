#!/usr/bin/env bash
# pre-commit: check exactly what is about to be committed, in the standards-mcp
# runner image with no network. Any finding blocks the commit.
#
#   phpcs    the staged content of each staged PHP file inside the staged
#            phpcs.xml's <file> scope (the whole scope when phpcs.xml itself
#            is staged).
#   PHPStan  the whole staged tree against the staged phpstan.neon, whenever
#            PHP, phpstan.neon or composer.lock is staged. It needs every class
#            to judge any one of them, so it can't look at staged files alone.
#
#   Infection  the staged class files (classes/*.php), whenever one is staged
#            and infection.json5 is in the index. PRINT-ONLY: it lists the
#            small changes to those files that the unit tests did not notice,
#            and never blocks the commit, not even when it cannot run (vendor
#            not installed, a unit test red, Docker trouble). It runs last and
#            only when phpcs and PHPStan passed. See CLAUDE.md, "Mutation
#            testing".
#
# Checking the index, not the working tree, means a half-staged file is judged
# on exactly what will be committed. vendor/ is gitignored, so it comes from the
# working tree, read-only.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass in an emergency: git commit --no-verify
set -euo pipefail

IMAGE="standards-codeception-runner:php8.5"   # new sites' production PHP; standards-mcp repos.yaml php_target
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

in_index() { git ls-files --error-unmatch -- "$1" >/dev/null 2>&1; }

PHPCS_FILES=()
if in_index phpcs.xml; then
    # <file>classes</file> becomes 'classes/*.php'; <file>prepend.php</file> stays as is.
    mapfile -t SCOPE < <(git show :phpcs.xml | sed -n 's#.*<file>\(.*\)</file>.*#\1#p' |
        while read -r f; do [[ $f == *.php ]] && echo "$f" || echo "$f/*.php"; done)
    if [ "${#SCOPE[@]}" -gt 0 ]; then
        if git diff --cached --quiet -- phpcs.xml; then
            mapfile -t PHPCS_FILES < <(git diff --cached --name-only --diff-filter=ACMR -- "${SCOPE[@]}")
        else
            mapfile -t PHPCS_FILES < <(git ls-files -- "${SCOPE[@]}")
        fi
    fi
fi

RUN_PHPSTAN=0
if in_index phpstan.neon && ! git diff --cached --quiet -- '*.php' phpstan.neon composer.lock; then
    RUN_PHPSTAN=1
fi

# classes/ is infection.json5's source directory; keep the two in step.
INFECTION_FILES=()
if in_index infection.json5; then
    mapfile -t INFECTION_FILES < <(git diff --cached --name-only --diff-filter=ACMR -- 'classes/*.php')
fi

[ "${#PHPCS_FILES[@]}" -eq 0 ] && [ "$RUN_PHPSTAN" -eq 0 ] && [ "${#INFECTION_FILES[@]}" -eq 0 ] && exit 0

need() {
    [ -e "vendor/bin/$1" ] && return
    echo "pre-commit: vendor/bin/$1 is missing; run the composer install in CLAUDE.md." >&2
    echo "pre-commit: bypass once with: git commit --no-verify" >&2
    exit 1
}
[ "${#PHPCS_FILES[@]}" -gt 0 ] && need phpcs
[ "$RUN_PHPSTAN" -eq 1 ] && need phpstan

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "pre-commit: Docker image $IMAGE is not available (is Docker running?)." >&2
    echo "pre-commit: the staged files could not be checked, so the commit is blocked." >&2
    echo "pre-commit: fix Docker, or bypass once with: git commit --no-verify" >&2
    exit 1
fi

STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT
git checkout-index --all --prefix="$STAGE/"
mkdir -p "$STAGE/vendor"

in_runner() {
    docker run --rm --network none \
        -v "$STAGE":/stage:ro \
        -v "$ROOT/vendor":/stage/vendor:ro \
        -w /stage \
        "$IMAGE" "$@"
}

# Run both before deciding, so one attempt reports every finding.
failed=()
if [ "${#PHPCS_FILES[@]}" -gt 0 ]; then
    in_runner php -d memory_limit=1G vendor/bin/phpcs --standard=phpcs.xml --no-colors -s "${PHPCS_FILES[@]}" ||
        failed+=(phpcs)
fi
if [ "$RUN_PHPSTAN" -eq 1 ]; then
    in_runner php -d memory_limit=1G vendor/bin/phpstan analyse -c phpstan.neon \
        --memory-limit=1G --no-progress --no-interaction ||
        failed+=(PHPStan)
fi

if [ "${#failed[@]}" -gt 0 ]; then
    echo "pre-commit: ${failed[*]} found problems in the staged content above, so the commit is blocked." >&2
    if [[ " ${failed[*]} " == *" phpcs "* ]]; then
        echo "pre-commit: auto-fix what phpcbf can, re-stage, and commit again:" >&2
        echo "  docker run --rm --network none -v \"$ROOT\":/app -w /app $IMAGE vendor/bin/phpcbf <files>" >&2
    fi
    exit 1
fi

# ── Infection: print-only ─────────────────────────────────────────────────
# Mutates only the staged class files and reports the mutants the Unit suite
# let through. Nothing in here may change the hook's exit status, so it is
# called as `infection_report || true` (which also switches off errexit
# inside it).
infection_report() {
    [ "${#INFECTION_FILES[@]}" -gt 0 ] || return 0
    if [ ! -e vendor/bin/infection ]; then
        echo "pre-commit: Infection is not installed (run the composer install in CLAUDE.md);" \
            "mutation check skipped, commit not blocked." >&2
        return 0
    fi

    local filter log count
    filter="$(IFS=,; echo "${INFECTION_FILES[*]}")"

    # pcov ships switched off in the image; turn it on for Infection and for
    # the test runs it starts. The text log lands in the container's /tmp
    # (infection.json5), so it is printed from inside.
    log="$(docker run --rm --network none \
        -v "$STAGE":/stage:ro \
        -v "$ROOT/vendor":/stage/vendor:ro \
        --tmpfs /stage/Tests/_output:rw \
        --tmpfs /stage/Tests/Support/_generated:rw \
        --tmpfs /tmp:rw,exec \
        -w /stage \
        "$IMAGE" sh -c '
            php -d pcov.enabled=1 vendor/bin/infection \
                --initial-tests-php-options="-d pcov.enabled=1" \
                --threads=max --no-progress --no-interaction --show-mutations=0 \
                "--filter=$1" >/tmp/infection.out 2>&1
            if [ -f /tmp/infection/infection.log ]; then
                echo "##INFECTION_LOG"
                cat /tmp/infection/infection.log
            else
                grep -v "^[[:space:]]*$" /tmp/infection.out | tail -n 6
            fi' sh "$filter" 2>&1)"

    if [[ "$log" != "##INFECTION_LOG"* ]]; then
        echo "pre-commit: Infection could not run (most often a failing unit test), so the mutation check was skipped. Commit not blocked:" >&2
        printf '%s\n' "$log" | sed 's/^/    /' >&2
        return 0
    fi

    # Keep the "Escaped mutants:" section; each section starts "<Kind> mutants:".
    log="$(printf '%s\n' "$log" | awk '
        /^Escaped mutants:$/ { keep = 1; next }
        /^[A-Z][A-Za-z ]* mutants:$/ { keep = 0 }
        keep' | sed -e 's#/stage/##' -e 's/ \[ID\] [0-9a-f]*$//')"
    count="$(printf '%s\n' "$log" | grep -c '^[0-9][0-9]*) ')"
    [ "$count" -gt 0 ] || return 0

    {
        echo
        echo "pre-commit: Infection made $count small change(s) to the staged class files that no unit test noticed."
        echo "pre-commit: each is a line a test runs but does not pin down. Printed only; the commit is NOT blocked."
        printf '%s\n' "$log" | grep -v '^=*$' | sed 's/^/    /'
        echo "pre-commit: to close one, see \"Mutation testing\" in CLAUDE.md."
    } >&2
}
infection_report || true
